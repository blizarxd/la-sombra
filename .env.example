# --- La Sombra environment variables (all optional) ---

# Path to the local SQLite database file. Default: ./data/la-sombra.db
# On Railway, point this at the mounted volume, e.g. /data/la-sombra.db
# DATABASE_PATH=./data/la-sombra.db

# Cloud operator scheduler (Railway). Set OPERATOR_SCHEDULER=1 to run the
# paper-only operator loop inside the web service on an interval. Off by
# default so local `npm run dev` stays quiet.
# OPERATOR_SCHEDULER=1
# OPERATOR_INTERVAL_MINUTES=20

# Telegram alerts (optional). If unset, reports are stored in DB only.
# Never commit real tokens. Values are redacted in logs.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Override Polymarket public API base URLs (rarely needed)
# POLYMARKET_DATA_API=https://data-api.polymarket.com
# POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_API=https://clob.polymarket.com

# How many leaderboard wallets to scan (default 500)
# LEADERBOARD_SCAN_LIMIT=500
